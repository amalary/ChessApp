pipeline {
  agent any

  environment {
    DOCKERHUB = credentials('dockerhub-credentials')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Lint: Frontend') {
      agent {
        docker {
          image 'node:22-alpine'     // or node:20-alpine / node:18-alpine if you prefer
        }
      }
      steps {
        dir('frontend') {
          sh 'npm ci'
          sh 'npx eslint .'
        }
      }
    }

    stage('Lint: Backend') {
      steps {
        dir('backend') {
          sh 'python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt ruff black'
          sh '. .venv/bin/activate && ruff check app && black --check app'
        }
      }
    }

    stage('Unit Tests (optional)') {
      steps {
        echo 'Add jest/pytest here when ready'
      }
    }

    stage('Build Docker Images') {
      steps {
        // DOCKERHUB_USR comes from the credentials() binding above
        sh 'docker build -t ${DOCKERHUB_USR}/puzzle-frontend:latest ./frontend'
        sh 'docker build -t ${DOCKERHUB_USR}/puzzle-backend:latest ./backend'
      }
    }

    stage('Push Images') {
      steps {
        // DOCKERHUB_PSW also comes from the same credentials() binding
        sh 'echo ${DOCKERHUB_PSW} | docker login -u ${DOCKERHUB_USR} --password-stdin'
        sh 'docker push ${DOCKERHUB_USR}/puzzle-frontend:latest'
        sh 'docker push ${DOCKERHUB_USR}/puzzle-backend:latest'
      }
    }
  }

  // post {
  //   always {
  //     cleanWs()
  //   }
  // }
}
