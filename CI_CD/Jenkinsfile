pipeline {
  agent any

  parameters {
    string(name: 'GCP_PROJECT_ID', defaultValue: '', description: 'Google Cloud project ID, not the numeric project number.')
    string(name: 'GCP_REGION', defaultValue: 'us-central1', description: 'Cloud Run and Artifact Registry region.')
    string(name: 'ARTIFACT_REPOSITORY', defaultValue: 'chessapp', description: 'Artifact Registry Docker repository name.')
    string(name: 'BACKEND_SERVICE', defaultValue: 'chess-backend', description: 'Existing or desired Cloud Run backend service name.')
    string(name: 'FRONTEND_SERVICE', defaultValue: 'chessapp-frontend', description: 'Existing or desired Cloud Run frontend service name.')
    string(name: 'BACKEND_BASE_URL', defaultValue: 'https://chess-backend-580461236477.us-central1.run.app', description: 'Public backend URL used by the frontend and CORS.')
    string(name: 'FRONTEND_BASE_URL', defaultValue: '', description: 'Optional public frontend URL. Leave blank to use the generated Cloud Run URL.')
    booleanParam(name: 'DEPLOY_TO_CLOUD_RUN', defaultValue: true, description: 'Deploy backend and frontend after pushing images.')
  }

  environment {
    DOCKERHUB = credentials('dockerhub-credentials')
    GCP_SERVICE_ACCOUNT_KEY_CREDENTIAL_ID = 'gcp-service-account-key'
  }

  stages {
    stage('Jenkinsfile Version') {
      steps {
        echo "JENKINSFILE VERSION: smoke-test-disabled-v1"
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.SHORT_SHA = sh(
            script: 'git rev-parse --short=12 HEAD',
            returnStdout: true
          ).trim()
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.SHORT_SHA}"
        }
      }
    }

    stage('Validate Deployment Settings') {
      when {
        expression { return params.DEPLOY_TO_CLOUD_RUN }
      }
      steps {
        script {
          if (!params.GCP_PROJECT_ID?.trim()) {
            error('Set the GCP_PROJECT_ID Jenkins parameter before deploying to Cloud Run.')
          }
          if (!params.BACKEND_BASE_URL?.trim()) {
            error('Set BACKEND_BASE_URL to the public backend Cloud Run URL.')
          }
        }
      }
    }

stage('Lint: Frontend') {
  steps {
    sh '''
      echo "Listing frontend dir from Jenkins container:"
      ls -la frontend

      echo "Running npm install + eslint inside node:22-alpine using jenkins_home volume..."
      docker run --rm \
        -v jenkins_home:/jenkins_home \
        -w /jenkins_home/workspace/ChessApp/frontend \
        node:22-alpine \
        sh -c "ls -la && npm install && npx eslint ."
    '''
  }
}


    stage('Lint: Backend') {
      steps {
        dir('backend') {
          sh 'python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt ruff black'
          sh '. .venv/bin/activate && ruff check app && black --check app'
        }
      }
    }

    stage('Unit Tests (optional)') {
      steps {
        echo 'Add jest/pytest here when ready'
      }
    }

    stage('Build Docker Images') {
      steps {
        sh '''
          echo "Current commit:"
          git log -1 --oneline
          echo "Backend Dockerfile:"
          cat backend/Dockerfile
        '''
        sh 'docker build --build-arg BACKEND_URL="${BACKEND_BASE_URL}" --build-arg NEXT_PUBLIC_BACKEND_URL="${BACKEND_BASE_URL}" -t ${DOCKERHUB_USR}/puzzle-frontend:latest ./frontend'
        sh 'docker build --no-cache -t ${DOCKERHUB_USR}/puzzle-backend:latest ./backend'
        sh '''
          set -eu
          if [ "${DEPLOY_TO_CLOUD_RUN}" != "true" ]; then
            exit 0
          fi

          REGISTRY="${GCP_REGION}-docker.pkg.dev"
          IMAGE_PREFIX="${REGISTRY}/${GCP_PROJECT_ID}/${ARTIFACT_REPOSITORY}"
          docker tag "${DOCKERHUB_USR}/puzzle-frontend:latest" "${IMAGE_PREFIX}/frontend:${IMAGE_TAG}"
          docker tag "${DOCKERHUB_USR}/puzzle-frontend:latest" "${IMAGE_PREFIX}/frontend:latest"
          docker tag "${DOCKERHUB_USR}/puzzle-backend:latest" "${IMAGE_PREFIX}/backend:${IMAGE_TAG}"
          docker tag "${DOCKERHUB_USR}/puzzle-backend:latest" "${IMAGE_PREFIX}/backend:latest"
        '''
      }
    }

    stage('Smoke: Backend Container Startup') {
      steps {
        sh '''
          docker rm -f backend-cloudrun-test >/dev/null 2>&1 || true
          docker run -d --name backend-cloudrun-test -e PORT=8080 amalary10/puzzle-backend:latest
          sleep 8
          docker logs backend-cloudrun-test
          docker ps -a | grep backend-cloudrun-test
          docker rm -f backend-cloudrun-test
        '''
      }
    }

    stage('Push Images') {
      steps {
        sh 'echo ${DOCKERHUB_PSW} | docker login -u ${DOCKERHUB_USR} --password-stdin'
        sh 'docker push ${DOCKERHUB_USR}/puzzle-frontend:latest'
        sh 'docker push ${DOCKERHUB_USR}/puzzle-backend:latest'
      }
    }

    stage('Push Artifact Registry Images') {
      when {
        expression { return params.DEPLOY_TO_CLOUD_RUN }
      }
      steps {
        withCredentials([file(credentialsId: "${env.GCP_SERVICE_ACCOUNT_KEY_CREDENTIAL_ID}", variable: 'GCP_SERVICE_ACCOUNT_KEY_FILE')]) {
          sh '''
            set -eu
            REGISTRY="${GCP_REGION}-docker.pkg.dev"
            IMAGE_PREFIX="${REGISTRY}/${GCP_PROJECT_ID}/${ARTIFACT_REPOSITORY}"

            gcloud auth activate-service-account --key-file="${GCP_SERVICE_ACCOUNT_KEY_FILE}"
            gcloud config set project "${GCP_PROJECT_ID}"
            gcloud artifacts repositories describe "${ARTIFACT_REPOSITORY}" \
              --location "${GCP_REGION}" >/dev/null 2>&1 || \
              gcloud artifacts repositories create "${ARTIFACT_REPOSITORY}" \
                --repository-format docker \
                --location "${GCP_REGION}" \
                --description "ChessApp Docker images"
            gcloud auth configure-docker "${REGISTRY}" --quiet

            docker push "${IMAGE_PREFIX}/frontend:${IMAGE_TAG}"
            docker push "${IMAGE_PREFIX}/frontend:latest"
            docker push "${IMAGE_PREFIX}/backend:${IMAGE_TAG}"
            docker push "${IMAGE_PREFIX}/backend:latest"
          '''
        }
      }
    }

    stage('Deploy Cloud Run') {
      when {
        expression { return params.DEPLOY_TO_CLOUD_RUN }
      }
      steps {
        withCredentials([file(credentialsId: "${env.GCP_SERVICE_ACCOUNT_KEY_CREDENTIAL_ID}", variable: 'GCP_SERVICE_ACCOUNT_KEY_FILE')]) {
          sh '''
            set -eu
            REGISTRY="${GCP_REGION}-docker.pkg.dev"
            IMAGE_PREFIX="${REGISTRY}/${GCP_PROJECT_ID}/${ARTIFACT_REPOSITORY}"
            BACKEND_IMAGE="${IMAGE_PREFIX}/backend:${IMAGE_TAG}"
            FRONTEND_IMAGE="${IMAGE_PREFIX}/frontend:${IMAGE_TAG}"
            CLOUD_SQL_INSTANCE="${GCP_PROJECT_ID}:us-west2:chess-app-project"

            gcloud auth activate-service-account --key-file="${GCP_SERVICE_ACCOUNT_KEY_FILE}"
            gcloud config set project "${GCP_PROJECT_ID}"

            gcloud run deploy "${BACKEND_SERVICE}" \
              --image "${BACKEND_IMAGE}" \
              --region "${GCP_REGION}" \
              --platform managed \
              --port 8080 \
              --timeout 180s \
              --allow-unauthenticated \
              --add-cloudsql-instances "${CLOUD_SQL_INSTANCE}" \
              --update-secrets "DB_PASSWORD=chess-db-pass:latest,GOOGLE_API_KEY=gemini-api-key:latest,GEMINI_API_KEY=gemini-api-key:latest,AUTH0_CLIENT_ID=chessapp-auth0-client-id:latest,AUTH0_CLIENT_SECRET=chessapp-auth0-client-secret:latest,AUTH0_SECRET=chessapp-auth0-secret:latest,LOCAL_AUTH_SESSION_SECRET=chessapp-auth0-secret:latest" \
              --set-env-vars "APP_ENV=production,DB_NAME=chessapp,DB_USER=app_user,CLOUD_SQL_CONNECTION_NAME=${CLOUD_SQL_INSTANCE},STOCKFISH_PATH=/usr/games/stockfish,AUTH0_DOMAIN=dev-67f56xwhohhonhmt.us.auth0.com,AUTH0_AUDIENCE=https://chessapp-backend,ALLOW_LOCAL_AUTH_FALLBACK=true,SYNC_LOCAL_AUTH_WITH_AUTH0=false,GEMINI_MODEL=gemini-2.5-flash,GEMINI_TRANSCRIBE_ATTEMPTS=7,GEMINI_MAX_ATTEMPTS_HARD_CAP=7,GEMINI_MIN_CONSENSUS_VOTES=2,GEMINI_CONSENSUS_EXIT_VOTES=3,GEMINI_IMAGE_MIN_DIMENSION=1400,GEMINI_IMAGE_MAX_DIMENSION=2200,SOLVER_MATE_THINK_TIME_SECONDS=12,SOLVER_BEST_LINE_THINK_TIME_SECONDS=8,SOLVER_CANDIDATE_EVALUATION_LIMIT=4,AGENT_FAIL_OPEN_ON_RETRIEVAL_ERRORS=true"

            gcloud run deploy "${FRONTEND_SERVICE}" \
              --image "${FRONTEND_IMAGE}" \
              --region "${GCP_REGION}" \
              --platform managed \
              --allow-unauthenticated \
              --update-secrets "AUTH0_DOMAIN=chessapp-auth0-domain:latest,AUTH0_CLIENT_ID=chessapp-auth0-client-id:latest,AUTH0_CLIENT_SECRET=chessapp-auth0-client-secret:latest,AUTH0_SECRET=chessapp-auth0-secret:latest,AUTH0_AUDIENCE=chessapp-auth0-audience:latest" \
              --set-env-vars "NODE_ENV=production,BACKEND_URL=${BACKEND_BASE_URL},NEXT_PUBLIC_BACKEND_URL=${BACKEND_BASE_URL},APP_BASE_URL=${FRONTEND_BASE_URL:-https://pending.example.com}"

            RESOLVED_FRONTEND_URL="${FRONTEND_BASE_URL:-$(gcloud run services describe "${FRONTEND_SERVICE}" --region "${GCP_REGION}" --format='value(status.url)')}"
            PROJECT_NUMBER="$(gcloud projects describe "${GCP_PROJECT_ID}" --format='value(projectNumber)')"
            CANONICAL_FRONTEND_URL="https://${FRONTEND_SERVICE}-${PROJECT_NUMBER}.${GCP_REGION}.run.app"

            gcloud run services update "${FRONTEND_SERVICE}" \
              --region "${GCP_REGION}" \
              --update-env-vars "APP_BASE_URL=${RESOLVED_FRONTEND_URL},BACKEND_URL=${BACKEND_BASE_URL},NEXT_PUBLIC_BACKEND_URL=${BACKEND_BASE_URL}"

            gcloud run services update "${BACKEND_SERVICE}" \
              --region "${GCP_REGION}" \
              --update-env-vars "^|^CORS_ALLOWED_ORIGINS=${RESOLVED_FRONTEND_URL},${CANONICAL_FRONTEND_URL}"

            echo "Frontend URL: ${RESOLVED_FRONTEND_URL}"
            echo "Frontend canonical URL: ${CANONICAL_FRONTEND_URL}"
            echo "Backend URL: ${BACKEND_BASE_URL}"
          '''
        }
      }
    }

    stage('Smoke: Deployed Backend') {
      when {
        expression { return params.DEPLOY_TO_CLOUD_RUN }
      }
      steps {
        sh 'curl -fsS "${BACKEND_BASE_URL}/health"'
      }
    }
  }
}

